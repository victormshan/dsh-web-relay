{
  "manifest_version": 3,
  "name": "dsh-web-gemini-ext",
  "version": "0.2.1",
  "description": "dsh-relay web-gemini 通道：主 agent ↔ gemini.google.com 网页自动交流（无 API Key、免配额）",
  "permissions": [
    "alarms"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://localhost:8899/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
